# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# secrets locaux ; seul le modèle sans identifiants est versionné
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

#test
work/

# md files
CHECKLIST.md

# Bases locales et journaux SQLite
/data/
*.sqlite
*.sqlite-*
*.db
*.db-*

# Exports locaux de base (jamais les migrations SQL dans drizzle/)
/backups/
*.dump

# src/db/, drizzle/ et drizzle.config.ts doivent rester versionnés.
